    <AndroidEnableMultiDex>false</AndroidEnableMultiDex>
    <AndroidKeyStore>false</AndroidKeyStore>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.Core">
      <Version>1.8.0.1</Version>
    </PackageReference>
    <PackageReference Include="Xamarin.Google.Android.Material">
      <Version>1.11.0.1</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Element_Symbol_Flash_Card\Element_Symbol_Flash_Card.csproj" />
  </ItemGroup>
  <ProjectExtensions>
    <VisualStudio>
      <UserProperties XamarinHotReloadWrongLinkerErrorInfoBarElement_Symbol_Flash_CardAndroidHideInfoBar="True" />
    </VisualStudio>
  </ProjectExtensions>
